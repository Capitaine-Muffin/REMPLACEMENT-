# Synchronisation multi-appareils (facultatif).
# Sans ces deux valeurs, l'application fonctionne en local sur l'appareil.
# Cree un projet Supabase en region europeenne, execute supabase/schema.sql,
# puis copie ce fichier en .env.local et renseigne les valeurs ci-dessous.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
